# Backend environment. Copy to backend/.env and fill in real values.
# Never commit .env or real secrets — only this example is committed.

# Core
DEBUG=true
SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — set DB_NAME to use PostgreSQL; leave unset to use local SQLite.
DB_NAME=e3_lms
DB_USER=e3_lms
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432

# CORS / CSRF — the SPA origin(s) allowed to send credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Cookies — set these true behind HTTPS in shared/production environments.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax

# Display timezone for the institution.
INSTITUTION_TIME_ZONE=Africa/Lagos

# Email (console backend by default).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Background services (used by later phases).
REDIS_URL=redis://localhost:6379/0
