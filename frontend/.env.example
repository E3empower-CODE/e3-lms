# Frontend environment. Copy to `.env.local` for local development.
# Only VITE_-prefixed variables reach browser code — never put secrets here.

# Base URL of the Django REST API (include the /api/v1 prefix).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Institution display timezone and currency (display formatting only).
VITE_DISPLAY_TIMEZONE=Africa/Lagos
VITE_CURRENCY=NGN

# Auth endpoint paths — provisional until backend Phase 1 finalizes them.
# Override here if the backend uses different paths during early integration.
# VITE_AUTH_LOGIN_PATH=/auth/login/
# VITE_AUTH_LOGOUT_PATH=/auth/logout/
# VITE_AUTH_ME_PATH=/auth/me/
# VITE_AUTH_PASSWORD_RESET_PATH=/auth/password/reset/
# VITE_AUTH_PASSWORD_RESET_CONFIRM_PATH=/auth/password/reset/confirm/
# VITE_AUTH_PASSWORD_CHANGE_PATH=/auth/password/change/
